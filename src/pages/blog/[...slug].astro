---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatNames, getBlogPosts, postAuthors, postDate, postUrl, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are sorted newest first.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const authors = formatNames(postAuthors(post));
const thanks = post.data.thanks;
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={postDate(post)} />
    {authors && <meta name="author" content={authors} />}
  </Fragment>

  <div class="progress" aria-hidden="true"><span></span></div>

  <article class="container" data-pagefind-body>
    <header class="post-header">
      <a class="back" href="/blog/" data-pagefind-ignore>← All posts</a>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="description">{post.data.description}</p>}
      <PostMeta post={post} avatarSize={32} full />
      {thanks && thanks.length > 0 && <p class="thanks">With thanks to {formatNames(thanks)}.</p>}
    </header>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>
      <aside>
        <div class="sticky" data-pagefind-ignore>
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>

    {
      (newer || older) && (
        <nav class="pager" aria-label="More posts" data-pagefind-ignore>
          {older ? (
            <a href={postUrl(older)} class="older">
              <span>← Previous post</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={postUrl(newer)} class="newer">
              <span>Next post →</span>
              {newer.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
  }
  .post-header {
    max-width: var(--prose-width);
    padding: 3.5rem 0 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .description {
    margin: 0 0 1.75rem;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .thanks {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--prose-width)) minmax(0, 1fr);
    gap: 4rem;
  }
  aside {
    min-width: 0;
  }
  .sticky {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    max-height: calc(100vh - var(--header-height) - 4rem);
    overflow-y: auto;
    max-width: 16rem;
  }
  @media (max-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-header,
    .layout {
      max-width: var(--prose-width);
      margin-inline: auto;
    }
    aside {
      display: none;
    }
  }
  .pager {
    max-width: var(--prose-width);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 64rem) {
    .pager {
      margin-inline: auto;
    }
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--text);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .pager a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .pager a span {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .pager .newer {
    text-align: right;
    grid-column: 2;
  }
  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .newer {
      grid-column: 1;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.progress');
  const article = document.querySelector<HTMLElement>('.prose');
  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.setProperty('--progress', String(p));
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }

  // Add hover anchor links to headings.
  for (const h of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]')) {
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${h.id}`;
    a.ariaLabel = 'Link to this section';
    a.textContent = '#';
    h.append(a);
  }
</script>
