---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getBlogPosts, postDate, postUrl, type Post } from '../../utils/posts';

const posts = await getBlogPosts();
const byYear = new Map<string, Post[]>();
for (const post of posts) {
  const year = postDate(post)!.slice(0, 4);
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout title="All posts" description="All posts on the RiSE MSR blog, newest first.">
  <div class="container">
    <header class="page-header">
      <span class="eyebrow">Archive</span>
      <h1>All posts</h1>
      <p>{posts.length} posts from the RiSE group at Microsoft Research, newest first.</p>
    </header>

    {
      [...byYear].map(([year, yearPosts]) => (
        <section class="year">
          <h2>{year}</h2>
          <ol>
            {yearPosts.map((post) => (
              <li>
                <a class="row" href={postUrl(post)}>
                  <h3>{post.data.title}</h3>
                  {post.data.description && <p>{post.data.description}</p>}
                </a>
                <PostMeta post={post} avatarSize={20} />
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 4rem 0 2rem;
    max-width: 44rem;
  }
  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .page-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.1rem;
  }
  .year {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    margin-top: 2rem;
  }
  .year h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  li {
    position: relative;
    padding: 1.25rem 1.5rem;
    margin-inline: -1.5rem;
    border-radius: var(--radius);
    transition: background-color 0.15s;
  }
  li:hover,
  li:focus-within {
    background: var(--surface);
  }
  .row {
    display: block;
    color: inherit;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .row::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }
  li:hover h3 {
    color: var(--accent);
  }
  .row p {
    margin: 0;
    color: var(--text-muted);
    max-width: 65ch;
  }
  @media (max-width: 40rem) {
    .year {
      grid-template-columns: 1fr;
    }
  }
</style>
