---
import Avatar from './Avatar.astro';
import AuthorNames from './AuthorNames.astro';
import { authorUrl, formatDate, postAuthors, postDate, readingTime, type Post } from '../utils/posts';

interface Props {
  post: Post;
  avatarSize?: number;
  /** List every author by name (otherwise "First author and N others"). */
  full?: boolean;
}
const { post, avatarSize = 24, full = false } = Astro.props;
const date = postDate(post);
const authors = postAuthors(post);
const maxAvatars = full ? 4 : 3;
const maxNames = full || authors.length <= 2 ? Infinity : 1;
---

<div class="post-meta">
  {
    authors.length > 0 && (
      <span class="author">
        <span class="avatars">
          {authors.slice(0, maxAvatars).map((a) => (
            <a href={authorUrl(a)} tabindex="-1" aria-hidden="true">
              <Avatar name={a} size={avatarSize} />
            </a>
          ))}
        </span>
        <AuthorNames authors={authors} max={maxNames} />
      </span>
    )
  }
  <span class="details">
    <time datetime={date}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(post)} min read</span>
  </span>
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .author {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 550;
    color: var(--text);
  }
  .avatars {
    display: inline-flex;
    flex: none;
  }
  .avatars > a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    transition: transform 0.15s;
  }
  .avatars > a:hover {
    z-index: 2;
    transform: translateY(-2px);
  }
  .avatars > a + a {
    margin-left: -0.4em;
  }
  .details {
    display: inline-flex;
    gap: 0.5rem;
  }
</style>
