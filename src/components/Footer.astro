---
import { RISE_URL } from '../consts';
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <a class="brand" href="/">RiSE MSR Blog</a>
      <p>Research in Software Engineering at Microsoft Research.</p>
    </div>
    <nav aria-label="Footer">
      <a href="/blog/">All posts</a>
      <a href="/authors/">Authors</a>
      <a href={RISE_URL}>RiSE</a>
      <a href="https://www.microsoft.com/en-us/research/">Microsoft Research</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .brand {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  p {
    margin: 0.5rem 0 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  nav a {
    color: var(--text-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
  }
</style>
